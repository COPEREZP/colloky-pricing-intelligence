# PostgreSQL connection used by colloky_scraper.py.
# The scraper reads these ENVIRONMENT VARIABLES (it does not read this file
# by itself). Set them in your system, in the .bat/.sh launcher, or in
# Jupyter with %env before running. Never commit real credentials.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=postgres

# Optional: resume an interrupted snapshot
# COLLOKY_REANUDAR_SNAPSHOT=2026-10-06 08:47:00
